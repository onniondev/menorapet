# Copie para .env.evolution (usado pelo docker-compose.evolution.yml)
EVOLUTION_API_KEY=change-me-strong-key
EVOLUTION_WEBHOOK_SECRET=change-me-webhook-secret

# Configurações Evolution v2 (consulte documentação oficial)
CONFIG_SESSION_PHONE_CLIENT=Chrome
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@postgres:5432/evolution
