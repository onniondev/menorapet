{
  "name": "menorapet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-api.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "node scripts/run-sql-file.mjs supabase/migrations/20260214120000_petvia_foundation.sql",
    "db:check": "node scripts/check-supabase-schema.mjs",
    "db:seed-sample": "node scripts/run-sql-file.mjs supabase/seeds/petvia_dashboard_sample.sql",
    "db:migrate-whatsapp": "node scripts/run-sql-file.mjs supabase/migrations/20260315120000_whatsapp_meta.sql",
    "db:migrate-whatsapp-evolution": "node scripts/run-sql-file.mjs supabase/migrations/20260320120000_whatsapp_evolution.sql",
    "db:migrate-whatsapp-all": "node scripts/apply-whatsapp-migrations.mjs",
    "evolution:setup": "node scripts/setup-evolution.mjs",
    "evolution:up": "node scripts/evolution-up.mjs",
    "evolution:down": "docker compose -f docker-compose.evolution.yml down",
    "evolution:logs": "docker logs -f petvia-evolution-api",
    "evolution:status": "docker compose -f docker-compose.evolution.yml ps",
    "evolution:webhook-secret": "node scripts/generate-webhook-secret.mjs",
    "dev:api": "vercel dev",
    "dev:full": "npm run evolution:up && vercel dev"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
