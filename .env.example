# Copie para .env.local e preencha com o projeto Supabase (Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: ver página /marketing-ia com dados mock sem Supabase (apenas desenvolvimento)
# VITE_MARKETING_IA_DEMO=1

# Opcional: só para `npm run db:migrate` (Settings → Database → Connect).
# Não use no frontend. Senha com @ ! # etc. deve estar URL-encoded.
# Vercel/serverless: NÃO use db.PROJECT_REF.supabase.co (só IPv6). Use Session pooler:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:senha_url_encoded@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# (não use sslmode= na URL — o servidor configura SSL para Supabase automaticamente)
# Transaction pooler (porta 6543): acrescente pgbouncer=true na query string.

# --- WhatsApp Business Cloud API (Meta) — somente servidor / Vercel (NUNCA no bundle Vite) ---
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=
# OPENAI_API_KEY=
# DEFAULT_CLINIC_ID=uuid-da-clinica-opcional

# API interna (frontend): vazio = mesma origem no deploy
# VITE_API_BASE_URL=

# --- WhatsApp QR Code (padrão) — Evolution em VPS com URL pública — ver docs/evolution-vps.md ---
# WHATSAPP_PROVIDER=evolution
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=
# APP_URL=https://menorapet.vercel.app
# DEFAULT_CLINIC_ID=uuid-opcional-se-um-numero-meta-para-todas

# --- Evolution API (opcional, QR Code — exige servidor pago) ---
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_WEBHOOK_SECRET=
